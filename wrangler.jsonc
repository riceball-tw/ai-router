{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-router-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // The TypeSafe SDK reads process.env and process.versions; nodejs_compat provides them.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Per-IP rate limit on /api/*, so an open endpoint cannot burn the TypeSafe key.
  // Counted per colo, not globally; namespace_id is any number unique within the account.
  "ratelimits": [
    {
      "name": "INTENT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  // No assets binding: the frontend is deployed separately to Cloudflare Pages.
  // To serve both from one origin instead, add:
  //   "assets": { "directory": "./dist", "binding": "ASSETS",
  //               "not_found_handling": "single-page-application" }
}
